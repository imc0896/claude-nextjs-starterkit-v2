{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "sequential-thinking": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    },
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "hiworks-mail-mcp": {
      "command": "node",
      "args": ["mcp-servers/hiworks-mail/index.mjs"],
      "env": {
        "HIWORKS_USERNAME": "${HIWORKS_USERNAME}",
        "HIWORKS_PASSWORD": "${HIWORKS_PASSWORD}"
      }
    }
  }
}
